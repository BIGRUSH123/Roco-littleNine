filters:
  and:
    - file.inFolder("wiki/技能图鉴/")
properties:
  name:
    displayName: 名称
  attribute:
    displayName: 属性
  type:
    displayName: 类型
  power:
    displayName: 威力
  energy_cost:
    displayName: 耗能
  counter:
    displayName: 应对
  description:
    displayName: 描述
views:
  - type: table
    name: 全技能图鉴
    groupBy:
      property: attribute
      direction: ASC
    order:
      - name
      - attribute
      - type
      - power
      - energy_cost
      - counter
      - description
