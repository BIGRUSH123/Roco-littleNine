{
  "id": 20064,
  "name": "散热",
  "description": "初始能量为0，入场前己方精灵每放1次火系技能，回复3能量。",
  "effects": [
    {
      "op": "observer",
      "listen": "post_entry",
      "scope": "battlefield",
      "cond": {
        "cond": "sprite_entered",
        "of": "sprite_self"
      },
      "then": [
        {
          "op": "energize",
          "target": "sprite_self",
          "delta": "=@team_counters[element:火] * 3"
        }
      ]
    }
  ]
}
