{
  "id": 20115,
  "name": "营养液泡",
  "description": "获得增益时，额外获得层数+2。",
  "effects": [
    {
      "op": "observer",
      "then": [
        {
          "target": "self",
          "op": "mutate_effect",
          "filter": {
            "is_stat": true,
            "steps>0": true
          },
          "delta_steps": 2,
          "limit_to_effect": true
        }
      ],
      "scope": "persistent",
      "cond": {
        "cond": "compare",
        "q": "effect.is_stat",
        "of": "sprite_self",
        "op": "eq",
        "value": true
      }
    }
  ]
}
