{
  "id": 20115,
  "name": "营养液泡",
  "description": "获得增益时，额外获得层数+2。",
  "effects": [
    {
      "op": "observer",
      "cond": {
        "cond": "on_positive_changed",
        "of": "sprite_self"
      },
      "listen": "post_positive_change",
      "scope": "persistent",
      "then": [
        {
          "op": "effect_delta",
          "target": "sprite_self",
          "what": "positive",
          "delta": 2
        }
      ]
    }
  ]
}
