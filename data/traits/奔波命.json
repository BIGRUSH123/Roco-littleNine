{
  "id": 20039,
  "name": "奔波命",
  "description": "使用防御技能后，回合结束时脱离。",
  "effects": [
    {
      "op": "observer",
      "cond": {
        "cond": "skill_use",
        "skill_type": "防御"
      },
      "listen": "post_skill",
      "scope": "persistent",
      "then": [
        {
          "op": "defer",
          "turns": 0,
          "at": "turn_end",
          "then": [
            {
              "op": "escape",
              "target": "sprite_self"
            }
          ]
        }
      ]
    }
  ]
}
