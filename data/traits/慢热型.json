{
  "id": 20053,
  "name": "慢热型",
  "description": "初始能量为0。入场前己方精灵每成功应对1次，回复5能量。",
  "effects": [
    {
      "op": "observer",
      "listen": "post_entry",
      "cond": {
        "cond": "sprite_entered",
        "of": "sprite_self"
      },
      "then": [
        {
          "op": "energize",
          "target": "sprite_self",
          "delta": -10
        },
        {
          "op": "energize",
          "target": "sprite_self",
          "delta": {
            "q": "team_counter",
            "of": "team_own",
            "name": "counter_success",
            "scale": 5
          }
        }
      ]
    }
  ]
}
