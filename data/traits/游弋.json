        {
          "op": "flag_set",
          "target": "sprite_self",
          "flag": "charge_any_skill",
          "value": true,
          "scope": "battlefield"
        },
        {
          "op": "mult_mod",
          "target": "sprite_self",
          "attr": "def",
          "value": 1,
          "mode": "add",
          "scope": "battlefield"
        },
        {
          "op": "mult_mod",
          "target": "sprite_self",
          "attr": "sp_def",
          "value": 1,
          "mode": "add",
          "scope": "battlefield"
        }
      ]
    }
  ]
}
