          },
          "then": [
            {
              "op": "mod",
              "target": "sprite_self",
              "stat": "def",
              "value": 0.8,
              "mode": "add"
            },
            {
              "op": "mod",
              "target": "sprite_self",
              "stat": "sp_def",
              "value": 0.8,
              "mode": "add"
            }
          ],
          "else": [
            {
              "op": "mod",
              "target": "sprite_self",
              "stat": "def",
              "value": -0.8,
              "mode": "add"
            },
            {
              "op": "mod",
              "target": "sprite_self",
              "stat": "sp_def",
              "value": -0.8,
              "mode": "add"
            }
          ]
        }
      ]
    }
  ]
