      "when": {
        "cond": "on_skills_energy_changed",
        "of": "sprite_self"
      },
      "then": [
        {
          "when": {
            "cond": "compare",
            "q": "skills_energy_sum",
            "of": "sprite_self",
            "op": "lt",
