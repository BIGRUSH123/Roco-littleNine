{
  "id": 20076,
  "name": "氧循环",
  "description": "使用草系技能后回复10%生命。",
  "effects": [
    {
      "op": "observer",
      "cond": {
        "cond": "skill_use",
        "element": "草"
      },
      "listen": "post_skill",
      "scope": "persistent",
      "then": [
        {
          "op": "heal",
          "target": "sprite_self",
          "value": "=@self.max_hp * 0.1"
        }
      ]
    }
  ]
}
