      "op": "observer",
      "listen": "post_entry",
      "scope": "battlefield",
      "cond": {
        "cond": "sprite_entered",
        "of": "sprite_self"
      },
      "then": [
        {
          "op": "power_mod",
          "target": "sprite_self",
          "attr": "energy_gain_delta",
          "delta": -4,
          "scope": "battlefield",
          "source": "盗魂铃"
        }
      ]
    },
    {
      "op": "observer",
      "listen": "post_entry",
      "scope": "persistent",
      "cond": {
        "cond": "and",
        "conditions": [
          {
            "cond": "sprite_entered",
            "of": "sprite_self"
          },
          {
            "cond": "compare",
            "q": "counter",
            "of": "sprite_self",
            "name": "盗魂铃_首次入场",
            "op": "eq",
            "value": 0
          }
        ]
      },
      "then": [
        {
          "op": "energize",
          "target": "sprite_self",
          "delta": {
            "q": "team_counter",
            "of": "team_own",
            "name": "enemy_gather",
            "scale": 5
          },
          "source": "盗魂铃"
        },
        {
          "op": "counter",
          "target": "sprite_self",
          "key": "盗魂铃_首次入场",
          "delta": 1
        }
      ]
    }
