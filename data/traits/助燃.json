          "value": 0.2,
          "mode": "add",
          "scope": "permanent"
        },
        {
          "op": "mult_mod",
          "target": "sprite_self",
          "attr": "sp_atk",
          "value": 0.2,
          "mode": "add",
          "scope": "permanent"
        }
      ]
    }
  ]
}
