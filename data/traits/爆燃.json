          "target": "sprite_self",
          "stat": "atk",
          "steps": 3,
          "scope": "permanent",
          "source": "爆燃"
        },
        {
          "op": "stat_stage",
          "target": "sprite_self",
          "stat": "sp_atk",
          "steps": 3,
          "scope": "permanent",
          "source": "爆燃"
        }
      ]
    }
  ]
}
