{
  "id": 20070,
  "name": "月牙雪糕",
  "description": "使用攻击技能时，敌方每层冻结视为1层额外星陨印记。",
  "effects": [
    {
      "op": "observer",
      "then": [
        {
          "target": "sprite_self",
          "op": "mark",
          "name": "星陨印记",
          "stacks": "=@target.effects[name=冻结].stacks"
        }
      ],
      "scope": "persistent",
      "cond": {
        "cond": "compare",
        "q": "skill.is_attack",
        "of": "sprite_self",
        "op": "eq",
        "value": true
      }
    }
  ]
}
