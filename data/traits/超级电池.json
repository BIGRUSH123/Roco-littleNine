{
  "name": "超级电池",
  "description": "每入场1次，获得双攻永久+30%。",
  "triggers": [
    {
      "on": "entry",
      "condition": {"path": "self.counters[times_entered]", "op": "gt", "value": 1},
      "effects_mode": "replace",
      "effects": [
        {"kind": "stat", "stat": "atk", "steps": "=@self.counters[times_entered] * 3", "scope": "permanent", "source": "超级电池"},
        {"kind": "stat", "stat": "sp_atk", "steps": "=@self.counters[times_entered] * 3", "scope": "permanent", "source": "超级电池"}
      ]
    }
  ]
}
