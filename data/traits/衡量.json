{
  "id": 20123,
  "name": "衡量",
  "description": "入场时复制敌方增益；在场时若敌方获得增益自己也会获得。",
  "effects": [
    {
      "op": "observer",
      "listen": "post_entry",
      "scope": "battlefield",
      "cond": {
        "cond": "sprite_entered",
        "of": "sprite_self"
      },
      "then": [
        {
          "op": "steal",
          "target": "sprite_opp",
          "what": "positive",
          "action": "copy"
        }
      ]
    },
    {
      "op": "observer",
      "listen": "post_positive_change",
      "scope": "persistent",
      "cond": {
        "cond": "on_positive_changed",
        "of": "sprite_opp"
      },
      "then": [
        {
          "op": "stat_stage",
          "target": "sprite_self",
          "stat": "=@positive_changed_stat",
          "steps": "=@positive_changed_steps"
        }
      ]
    }
  ]
}
