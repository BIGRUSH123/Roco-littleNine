{
  "id": 20108,
  "name": "美拉德反应",
  "description": "离场后，更换入场的精灵获得双攻+20%且免疫灼烧。",
  "effects": [
    {
      "op": "observer",
      "listen": "post_leave",
      "scope": "persistent",
      "cond": {
        "cond": "sprite_left",
        "of": "sprite_self"
      },
      "then": [
        {
          "op": "stat_stage",
          "target": "sprite_bench",
          "stat": "atk",
          "delta": 2,
          "scope": "permanent"
        },
        {
          "op": "stat_stage",
          "target": "sprite_bench",
          "stat": "sp_atk",
          "delta": 2,
          "scope": "permanent"
        },
        {
          "op": "mult_mod",
          "target": "sprite_bench",
          "attr": "immune_abnormal",
          "name": "灼烧",
          "value": 1
        }
      ]
    }
  ]
}
