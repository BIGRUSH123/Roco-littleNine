{
  "id": 20111,
  "name": "腐植循环",
  "description": "每回复1能量，同时回复5%生命。",
  "effects": [
    {
      "op": "observer",
      "scope": "persistent",
      "cond": {
        "cond": "on_energy_changed",
        "of": "sprite_self"
      },
      "then": [
        {
          "when": {
            "cond": "compare",
            "q": "energy_delta",
            "of": "sprite_self",
            "op": "gt",
            "value": 0
          },
          "then": [
            {
              "op": "heal",
              "target": "sprite_self",
              "value": "=@self.max_hp * 0.05 * @delta"
            }
          ]
        }
      ]
    }
  ]
}
