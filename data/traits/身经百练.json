      },
      "then": [
        {
          "op": "mult_mod",
          "target": "sprite_self",
          "attr": "power_mult",
          "value": "=1.0 + @player.team_counters[counter_success] * 0.2",
          "skill_where": {
            "element": "水"
          }
        },
        {
          "op": "mult_mod",
          "target": "sprite_self",
          "attr": "power_mult",
          "value": "=1.0 + @player.team_counters[counter_success] * 0.2",
          "skill_where": {
            "element": "武"
          }
        }
      ]
    }
  ]
}
