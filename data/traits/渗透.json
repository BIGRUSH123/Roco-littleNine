{
  "id": 20086,
  "name": "渗透",
  "description": "己方精灵每使用1次武系或地系技能，自己入场时获得攻防+5%。",
  "effects": [
    {
      "op": "observer",
      "then": [
        {
          "op": "mult_mod",
          "target": "sprite_self",
          "attr": "atk",
          "value": "=(@team_counters[element:武] + @team_counters[element:地]) * 0.05",
          "mode": "add",
          "scope": "battlefield",
          "source": "渗透"
        },
        {
          "op": "mult_mod",
          "target": "sprite_self",
          "attr": "def",
          "value": "=(@team_counters[element:武] + @team_counters[element:地]) * 0.05",
          "mode": "add",
          "scope": "battlefield",
          "source": "渗透"
        }
      ],
      "scope": "battlefield",
      "cond": {
        "cond": "sprite_entered",
        "of": "sprite_self"
      },
      "listen": "post_entry"
    }
  ]
}
