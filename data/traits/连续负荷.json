{
  "id": 20133,
  "name": "连续负荷",
  "description": "技能的迸发效果延长1回合。",
  "triggers": [
    {
      "op": "observer",
      "cond": {
        "cond": "sprite_entered",
        "of": "sprite_self"
      },
      "listen": [
        "post_entry"
