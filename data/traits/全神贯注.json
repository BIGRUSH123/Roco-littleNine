{
  "id": 20012,
  "name": "全神贯注",
  "description": "入场时获得物攻+100%，每次行动后-20%。",
  "effects": [
    {
      "op": "observer",
      "cond": {
        "cond": "sprite_entered",
        "of": "sprite_self"
      },
      "listen": "post_entry",
      "scope": "battlefield",
      "then": [
        {
          "op": "mult_mod",
          "target": "sprite_self",
          "attr": "atk",
          "value": 1,
          "mode": "add"
        }
      ]
    },
    {
      "op": "observer",
      "cond": {
        "cond": "sprite_acted",
        "of": "sprite_self"
      },
      "listen": "post_skill",
      "scope": "battlefield",
      "then": [
        {
          "op": "mult_mod",
          "target": "sprite_self",
          "attr": "atk",
          "value": -0.2,
          "mode": "add"
        }
      ]
    }
  ]
}
