{
  "id": 20021,
  "name": "双向光速",
  "description": "在场时，双方回合结束时的效果会额外触发1次。",
  "effects": [
    {
      "op": "observer",
      "cond": {
        "cond": "sprite_entered",
        "of": "sprite_self"
      },
      "listen": "post_entry",
      "scope": "battlefield",
      "then": [
        {
          "op": "flag_set",
          "target": "sprite_self",
          "flag": "extra_turn_end",
          "value": 1,
          "scope": "battlefield"
        }
      ]
    }
  ]
}
