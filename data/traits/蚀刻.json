{
  "id": 20121,
  "name": "蚀刻",
  "description": "回合结束时，敌方每2层中毒转化为1层中毒印记。",
  "effects": [
    {
      "op": "observer",
      "listen": "turn_end",
      "scope": "persistent",
      "cond": {
        "cond": "always"
      },
      "then": [
        {
          "op": "abnormal",
          "target": "sprite_opp",
          "name": "中毒",
          "value": "=-(int(@target.effects[name=中毒].stacks / 2) * 2)"
        },
        {
          "op": "mark",
          "target": "sprite_opp",
          "name": "中毒印记",
          "action": "apply",
          "value": "=int(@target.effects[name=中毒].stacks / 2)"
        }
      ]
    }
  ]
}
