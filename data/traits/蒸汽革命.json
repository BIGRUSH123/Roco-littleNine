{
  "id": 280037,
  "name": "蒸汽革命",
  "description": "己方精灵每使用1次火系技能，自己入场时获得全技能威力+10和物防+5%",
  "effects": [
    {
      "op": "observer",
      "listen": "post_entry",
      "scope": "battlefield",
      "cond": {
        "cond": "sprite_entered",
        "of": "sprite_self"
      },
      "then": [
        {
          "op": "power_mod",
          "target": "sprite_self",
          "attr": "power",
          "delta": "=@team_counters[element:火] * 10",
          "mode": "add",
          "skill_filter": "all",
          "scope": "permanent",
          "source": "蒸汽革命"
        },
        {
          "op": "mult_mod",
          "target": "sprite_self",
          "attr": "def",
          "value": "=@team_counters[element:火] * 0.05",
          "mode": "add",
          "scope": "permanent",
          "source": "蒸汽革命"
        }
      ]
    }
  ]
}
