{
  "id": 20080,
  "name": "洁癖",
  "description": "离场后，自己的增益和减益会被更换入场的精灵继承。",
  "effects": [
    {
      "op": "observer",
      "cond": {
        "cond": "sprite_left",
        "of": "sprite_self"
      },
      "listen": "post_leave",
      "scope": "persistent",
      "then": [
        {
          "op": "inherit",
          "source": "self",
          "via_pending": true,
          "inherit_stat_effects": true
        }
      ]
    }
  ]
}
