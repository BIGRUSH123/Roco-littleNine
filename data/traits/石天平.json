{
  "id": 20102,
  "name": "石天平",
  "description": "若使用技能能耗高于敌方，回合末敌方失去能耗之差的能量。",
  "effects": [
    {
      "op": "observer",
      "cond": {
        "cond": "and",
        "conditions": [
          {
            "cond": "skill_use"
          },
          {
            "cond": "compare",
            "q": "energy_cost",
            "of": "sprite_self",
            "op": "gt",
            "value": "=@target.energy_cost"
          }
        ]
      },
      "listen": "post_skill",
      "scope": "persistent",
      "then": [
        {
          "op": "schedule",
          "turns": 0,
          "at": "turn_end",
          "then": [
            {
              "op": "energize",
              "target": "sprite_opp",
              "delta": "=@target.energy_cost - @self.energy_cost"
            }
          ]
        }
      ]
    }
  ]
}
