{
  "name": "蓄电池",
  "description": "每入场1次，永久获得双攻+20%。",
  "triggers": [
    {
      "on": "entry",
      "condition": {"path": "self.counters[times_entered]", "op": "gt", "value": 1},
      "effects_mode": "replace",
      "effects": [
        {"kind": "stat", "stat": "atk", "steps": "=@self.counters[times_entered] * 2", "scope": "permanent", "source": "蓄电池"},
        {"kind": "stat", "stat": "sp_atk", "steps": "=@self.counters[times_entered] * 2", "scope": "permanent", "source": "蓄电池"}
      ]
    }
  ]
}
