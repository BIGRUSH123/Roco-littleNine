{
  "id": 20137,
  "name": "陨落",
  "description": "在场时，双方回合结束时的效果不会触发。",
  "triggers": [
    {
      "on": "entry",
      "flags": {
        "_downfall_active": true
      }
    },
    {
      "on": "leave",
      "flags": {
        "_downfall_active": false
      }
    }
  ],
  "effects": [
    {
      "op": "observer",
      "listen": "post_entry",
      "scope": "battlefield",
      "cond": {
        "cond": "sprite_entered",
        "of": "sprite_self"
      },
      "then": [
        {
          "op": "flag_set",
          "target": "sprite_self",
          "flag": "turn_end_block",
          "value": 1,
          "scope": "battlefield"
        }
      ]
    }
  ]
}
