{
  "id": 20063,
  "name": "搜刮",
  "description": "入场时，根据敌方队伍采集和换宠次数之和获得魔攻强化（每层+2）。",
  "effects": [
    {
      "op": "observer",
      "then": [
        {
          "target": "sprite_self",
          "scope": "battlefield",
          "source": "搜刮",
          "op": "stat_stage",
          "stat": "sp_atk",
          "steps": "=(@opponent.team_counters[enemy_gather] + @opponent.team_counters[enemy_switch]) * 2"
        }
      ],
      "scope": "battlefield",
      "cond": {
        "cond": "sprite_entered",
        "of": "sprite_self"
      },
      "listen": "post_entry"
    }
  ]
}
