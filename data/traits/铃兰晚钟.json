{
  "id": 20135,
  "name": "铃兰晚钟",
  "description": "首次入场时失去一半当前生命。",
  "effects": [
    {
      "op": "observer",
      "then": [
        {
          "op": "heal",
          "target": "sprite_self",
          "value": "=-round(@self.hp * 0.5)"
        }
      ],
      "scope": "persistent",
      "cond": {
        "cond": "and",
        "conditions": [
          {
            "cond": "sprite_entered",
            "of": "sprite_self"
          },
          {
            "cond": "compare",
            "q": "times_entered",
            "of": "sprite_self",
            "op": "lte",
            "value": 1
          }
        ]
      },
      "listen": "post_entry"
    }
  ]
}
