{
  "id": 20112,
  "name": "自由飘",
  "description": "自己每有1层萌化，获得连击数+2。",
  "effects": [
    {
      "op": "observer",
      "then": [
        {
          "target": "sprite_self",
          "scope": "persistent",
          "source": "自由飘",
          "op": "stat_stage",
          "stat": "combo",
          "steps": "=@self.effects[name=萌化].stacks * 2"
        }
      ],
      "scope": "battlefield",
      "cond": {
        "cond": "sprite_entered",
        "of": "sprite_self"
      },
      "listen": "post_entry"
    }
  ]
}
