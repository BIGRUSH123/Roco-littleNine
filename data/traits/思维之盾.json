{
  "id": 20049,
  "name": "思维之盾",
  "description": "应对成功后，下次行动技能能耗-5。",
  "effects": [
    {
      "op": "observer",
      "cond": {
        "cond": "counter_succeeded"
      },
      "then": [
        {
          "op": "mult_mod",
          "target": "sprite_self",
          "attr": "energy_cost",
          "value": -5,
          "on_next": true
        }
      ],
      "listen": "post_counter",
      "scope": "persistent"
    }
  ]
}
