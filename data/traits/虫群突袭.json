{
  "id": 20119,
  "name": "虫群突袭",
  "description": "队伍中每有1只其他虫系精灵，入场时获得攻防速+15%。",
  "effects": [
    {
      "op": "observer",
      "listen": "post_entry",
      "scope": "battlefield",
      "cond": {
        "cond": "sprite_entered",
        "of": "sprite_self"
      },
      "then": [
        {
          "op": "mult_mod",
          "target": "sprite_self",
          "attr": "atk",
          "value": "=(@team_counters[element:虫] - 1) * 0.15",
          "mode": "set"
        },
        {
          "op": "mult_mod",
          "target": "sprite_self",
          "attr": "def",
          "value": "=(@team_counters[element:虫] - 1) * 0.15",
          "mode": "set"
        },
        {
          "op": "mult_mod",
          "target": "sprite_self",
          "attr": "speed",
          "value": "=(@team_counters[element:虫] - 1) * 0.15",
          "mode": "set"
        }
      ]
    }
  ]
}
