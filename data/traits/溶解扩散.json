{
  "id": 20089,
  "name": "溶解扩散",
  "description": "每携带1个毒系技能进入战斗，水系技能使敌方获得1层中毒。",
  "effects": [
    {
      "op": "observer",
      "listen": "post_skill",
      "scope": "persistent",
      "cond": {
        "cond": "skill_use",
        "element": "水"
      },
      "then": [
        {
          "op": "abnormal",
          "target": "sprite_opp",
          "name": "中毒",
          "stacks": "=@self.skills[element=毒].count",
          "source": "溶解扩散"
        }
      ]
    }
  ]
}
